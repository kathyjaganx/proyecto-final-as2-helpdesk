    {
      "parameters": {
        "jsCode": "// =====================================================\n// WF1 - Validar datos del ticket y ocultar datos sensibles\n// Autora: Irma Yaritza Katiuxca Jagan Xol - 4090-23-9748\n// =====================================================\n\nconst body = $input.first().json.body || {};\nconst errores = [];\nconst CATEGORIAS = ['ACCESO', 'CORREO', 'HARDWARE', 'SOFTWARE', 'RED', 'OTRO'];\n\n// Limpiar los datos recibidos: quitar espacios sobrantes\nconst limpiar = (v) => String(v ?? '').trim().replace(/\\s+/g, ' ');\nconst solicitante = limpiar(body.solicitante);\nconst correo = limpiar(body.correo).toLowerCase();\nconst departamento = limpiar(body.departamento);\nconst categoria = limpiar(body.categoria).toUpperCase();\nconst asunto = limpiar(body.asunto);\nconst descripcionOriginal = String(body.descripcion ?? '').trim();\n\n// 1. Solicitante: solo letras y espacios, de 3 a 100 caracteres\nif (!/^[A-Za-zÁÉÍÓÚáéíóúÑñÜü ]{3,100}$/.test(solicitante)) {\n  errores.push('Solicitante inválido. Solo letras y espacios (3 a 100 caracteres)');\n}\n\n// 2. Correo: formato usuario@dominio.ext, máximo 120 caracteres\nif (correo.length > 120 || !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(correo)) {\n  errores.push('Correo inválido. Formato esperado: usuario@dominio.com');\n}\n\n// 3. Departamento: letras, números y espacios, de 2 a 60 caracteres\nif (!/^[A-Za-zÁÉÍÓÚáéíóúÑñÜü0-9 ]{2,60}$/.test(departamento)) {\n  errores.push('Departamento inválido. Solo letras, números y espacios (2 a 60 caracteres)');\n}\n\n// 4. Categoría: una de la lista\nif (!CATEGORIAS.includes(categoria)) {\n  errores.push('Categoría inválida. Valores permitidos: ' + CATEGORIAS.join(', '));\n}\n\n// 5. Asunto: de 5 a 150 caracteres, sin < ni > (evita que se envíe código HTML)\nif (asunto.length < 5 || asunto.length > 150 || /[<>]/.test(asunto)) {\n  errores.push('Asunto inválido. De 5 a 150 caracteres, sin los símbolos < ni >');\n}\n\n// 6. Descripción: de 10 a 2000 caracteres, sin < ni >\nif (descripcionOriginal.length < 10 || descripcionOriginal.length > 2000 || /[<>]/.test(descripcionOriginal)) {\n  errores.push('Descripción inválida. De 10 a 2000 caracteres, sin los símbolos < ni >');\n}\n\n// Protección de datos sensibles: ocultar contraseñas y números de tarjeta\n// antes de que la descripción llegue a la base de datos o a la auditoría\nconst patronClave = /\\b(contraseñas?|contrasenas?|claves?|password|pass|pin)\\b(\\s*(?:es|era|:|=)?\\s*)(\\S+)/gi;\nconst patronTarjeta = /\\b(?:\\d[ -]?){13,19}\\b/g;\nconst descripcion = descripcionOriginal\n  .replace(patronClave, (_, palabra, separador) => `${palabra}${separador}[OCULTO]`)\n  .replace(patronTarjeta, '[NÚMERO OCULTO]');\nconst datos_ocultados = descripcion !== descripcionOriginal;\n\nreturn [{\n  json: {\n    valido: errores.length === 0,\n    errores,\n    datos: { solicitante, correo, departamento, categoria, asunto, descripcion, datos_ocultados }\n  }\n}];"
      },
