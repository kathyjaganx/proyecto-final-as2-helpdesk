    {
      "parameters": {
        "jsCode": "// =====================================================\n// WF2 - Clasificar la prioridad del ticket\n// Autora: Irma Yaritza Katiuxca Jagan Xol - 4090-23-9748\n// =====================================================\n\nconst d = $input.first().json.datos;\nconst texto = `${d.asunto} ${d.descripcion}`.toLowerCase();\n\nconst URGENTE = ['urgente', 'caído', 'caido', 'caída', 'caida', 'no funciona', 'no enciende',\n                 'sin internet', 'no hay internet', 'servidor', 'virus', 'hackeo', 'bloqueado', 'bloqueada'];\nconst MENOR = ['consulta', 'duda', 'instalar', 'instalación', 'instalacion', 'solicitud',\n               'cuando puedan', 'no es urgente'];\nconst HORAS = { ALTA: 4, MEDIA: 24, BAJA: 72 };\n\n// \"no es urgente\" no debe contar como urgente\nconst textoUrgencia = texto.replaceAll('no es urgente', '');\nconst palabraUrgente = URGENTE.find(p => textoUrgencia.includes(p));\nconst palabraMenor = MENOR.find(p => texto.includes(p));\n\nlet prioridad, motivo;\nif (palabraUrgente) {\n  prioridad = 'ALTA';\n  motivo = `Contiene \"${palabraUrgente}\"`;\n} else if (palabraMenor) {\n  prioridad = 'BAJA';\n  motivo = `Contiene \"${palabraMenor}\"`;\n} else if (d.categoria === 'OTRO') {\n  prioridad = 'BAJA';\n  motivo = 'Categoría OTRO';\n} else {\n  prioridad = 'MEDIA';\n  motivo = 'Prioridad normal';\n}\n\nreturn [{ json: { ...d, prioridad, motivo_prioridad: motivo, horas_limite: HORAS[prioridad] } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        -320
      ],
      "id": "1d24b902-5338-4931-ae4a-780b64e3267f",
      "name": "Clasificar prioridad"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.id_tecnico, t.nombre, COUNT(k.id_ticket) AS tickets_abiertos\nFROM tecnicos t\nLEFT JOIN tickets k\n       ON k.id_tecnico = t.id_tecnico\n      AND k.estado IN ('ABIERTO', 'EN_PROCESO')\nWHERE t.activo = TRUE\n  AND t.especialidad IN ($1, 'GENERAL')\nGROUP BY t.id_tecnico, t.nombre, t.especialidad\nORDER BY (t.especialidad = 'GENERAL'), COUNT(k.id_ticket), t.id_tecnico\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.categoria }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
