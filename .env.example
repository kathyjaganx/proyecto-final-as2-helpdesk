# Copiar este archivo con el nombre .env y llenar con valores reales
# Para generar claves aleatorias en PowerShell:
# -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
POSTGRES_USER=usuario_aqui
POSTGRES_PASSWORD=contraseña_aqui
POSTGRES_DB=helpdesk
N8N_ENCRYPTION_KEY=clave_aleatoria_de_32_caracteres

# Clave X-API-Key del webhook (la misma de la credencial "API Key Tickets" en n8n)
N8N_API_KEY=clave_del_webhook